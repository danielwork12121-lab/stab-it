# Server
HOST=127.0.0.1
PORT=3001
NODE_ENV=production

# AI provider
AI_PROVIDER=doubao
AI_FALLBACK_PROVIDER=none

# Doubao Ark
DOUBAO_API_KEY=
DOUBAO_MODEL_ID=
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses

# MiniMax (fallback)
MINIMAX_API_KEY=
MINIMAX_MODEL_ID=
MINIMAX_API_URL=https://api.minimaxi.com/v1

# Debug
AI_DEBUG=false

# Budget tuning (ms)
AI_FUNCTION_MAX_DURATION_MS=60000
AI_RESPONSE_RESERVE_MS=10000
AI_FIRST_ATTEMPT_TIMEOUT_MS=85000
AI_RETRY_MIN_REMAINING_MS=20000